<div class="alert @CssClass border-1 border-dark">
    <h4>@Title</h4>
    <div>@DisplayMessage</div>
</div>


@code {
    /// <summary>
    /// The message to display in the box.
    /// </summary>

    [Parameter, EditorRequired]
    public string DisplayMessage { get; set; } = "";

    /// <summary>
    /// The title to display in the message box
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>
    /// the Css class to apply to the message box. Defaults alert-success. Use bootstrap alert colors
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = "alert-success";
}
